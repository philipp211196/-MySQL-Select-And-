Exercicio17 
SELECT ProductID AS 'Produtos',
        Quantity AS 'Quantidade',
		OrderID AS 'Ordem',
         OrderDetailID AS 'Ordem Detalhada'
FROM OrderDetails
WHERE OrderID >500
AND ProductID %3=0
ORDER BY Quantity ASC;

