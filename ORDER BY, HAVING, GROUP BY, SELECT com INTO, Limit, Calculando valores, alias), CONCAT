Bloco 1: Aquecimento e Exploração (CONCAT, Cálculos e LIMIT)
Exercicio 1 
SELECT CONCAT(ProductName, ' - ', Price * 2) AS 'Produto e Preço'
FROM Products
ORDER BY ProductName, Price
LIMIT 10;

Exercicio 2 
SELECT CONCAT(ProductName ,' $', Price) AS'preco dos produtos'
FROM Products
ORDER BY Price ASC
LIMIT 5;

Exercicio 3 
SELECT CONCAT(
           'OrderDetailID: ', OrderDetailID,
           ' - Valor Total: ', Quantity * 10
       ) AS 'Ordem em detalhe'
FROM OrderDetails
LIMIT 15;

Exercicio 4 
SELECT CONCAT('Primeiro nome- ',FirstName,
    ' | Sobrenome - ', LastName) AS'Funcionarios Senai' 
FROM Employees
ORDER BY FirstName ASC
LIMIT 3;

Exercicio 5 
SELECT ProductName AS 'Nome do Produto',
       CONCAT('R$ ', ROUND(Price * 0.85, 2)) AS 'Preco com 15% de desconto'
FROM Products
ORDER BY Price DESC
LIMIT 8;
















































Agrupamentos e Contagens (GROUP BY, COUNT e LIMIT)
Exercicio 1
SELECT City AS 'Cidade', 
       COUNT(CustomerID) AS "Numero de clientes"
FROM Customers
GROUP BY City 
ORDER BY COUNT(CustomerID) DESC
LIMIT 5;

Exercicio 2
SELECT CategoryID AS 'Identificacao de categoria',
       COUNT(ProductName) AS 'Numero de produto' 
FROM Products
GROUP BY CategoryID
ORDER BY CategoryID ASC
LIMIT 3 ;

Exercicio 3 
SELECT EmployeeID AS 'ID do Funcionario',
       COUNT(OrderID) AS 'Ordem dos pedidos' 
FROM Orders
GROUP BY EmployeeID 
ORDER BY COUNT(OrderID) DESC
LIMIT 5;

Exercicio 4
SELECT COUNT(SupplierID) AS 'Numero de fornecedores',
       Country AS Pais
FROM Suppliers
GROUP BY Country
ORDER BY COUNT(SupplierID) DESC
LIMIT 10;

Exercicio 5
SELECT OrderID AS 'ID do Pedido',
       COUNT(ProductID) AS 'Numero de produtos diferentes'
FROM OrderDetails
GROUP BY OrderID
ORDER BY COUNT(ProductID) DESC
LIMIT 15;








































Bloco 3: O Poder do Filtro em Agrupamentos (GROUP BY, HAVING e COUNT)

Exercicio 1 
SELECT Country AS Pais,
       COUNT(CustomerID) AS "Numero dos Clientes"
FROM Customers
GROUP BY Country
HAVING COUNT(CustomerID) > 5
ORDER BY COUNT(CustomerID) DESC;

Exercicio 2
SELECT EmployeeID AS Funcionarios,
       COUNT(OrderID) AS "PedidosID"
FROM Orders
GROUP BY EmployeeID
HAVING COUNT(OrderID) > 10
ORDER BY COUNT(OrderID) DESC;

Exercicio 3 
SELECT CategoryID AS 'Categoria',
 COUNT(ProductID) AS 'Numero de produtos'
FROM Products
GROUP BY CategoryID
HAVING COUNT(ProductID) > 12
ORDER BY COUNT(ProductID) DESC;

Exercicio 4 
SELECT City AS 'Cidade',
       COUNT(SupplierID) AS 'Numero de fornecedores'
FROM Suppliers
GROUP BY City
HAVING COUNT(SupplierID) =2
ORDER BY City ASC;

Exercicio 5 
SELECT OrderID AS 'Ordens',
       COUNT(DISTINCT ProductID) AS 'produtos distintos'
FROM OrderDetails
GROUP BY OrderID
HAVING COUNT(DISTINCT ProductID) > 3
ORDER BY COUNT(DISTINCT ProductID)  DESC;














































