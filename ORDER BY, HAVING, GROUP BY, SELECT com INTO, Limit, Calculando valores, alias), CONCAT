Bloco 3: O Poder do Filtro em Agrupamentos (GROUP BY, HAVING e COUNT)

Exercicio 1 
SELECT Country AS Pais,
       COUNT(CustomerID) AS "Numero dos Clientes"
FROM Customers
GROUP BY Country
HAVING COUNT(CustomerID) > 5
ORDER BY COUNT(CustomerID) DESC;

Exercicio 2
SELECT EmployeeID AS Funcionarios,
       COUNT(OrderID) AS "PedidosID"
FROM Orders
GROUP BY EmployeeID
HAVING COUNT(OrderID) > 10
ORDER BY COUNT(OrderID) DESC;

Exercicio 3 
SELECT CategoryID AS 'Categoria',
 COUNT(ProductID) AS 'Numero de produtos'
FROM Products
GROUP BY CategoryID
HAVING COUNT(ProductID) > 12
ORDER BY COUNT(ProductID) DESC;

Exercicio 4 
SELECT City AS 'Cidade',
       COUNT(SupplierID) AS 'Numero de fornecedores'
FROM Suppliers
